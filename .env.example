# Copy to `.env` (gitignored) and fill in. Read at startup by src/main/env.ts.
# A real environment variable always wins over this file, so
# `OPENROUTER_API_KEY=… npm run dev` still overrides it for one run.

# Chat + structured output, for whatever endpoint `baseUrl` points at
# (default: OpenRouter). OPENAI_API_KEY works as a fallback name, so pointing
# `baseUrl` at OpenAI/Groq/DeepSeek/Together needs no change here.
# A local Ollama or LM Studio server needs no key at all.
OPENROUTER_API_KEY=

# Embeddings, for Phase 5 extraction. Not needed to ask questions.
# OpenRouter serves chat but not embeddings, so this is a separate vendor.
VOYAGE_API_KEY=

# Only if you switch embeddings to an OpenAI-compatible endpoint
# ("embeddingProvider": "openai-compatible" in agent.json).
# EMBEDDING_API_KEY=

# Uncomment to run entirely offline against the deterministic mock provider —
# no keys needed, no network calls.
# TANGENT_MOCK_LLM=1
